extends layout

block content
  section.achievement-detail
    if achievement
      h1= achievement.title
      p.date Achieved on: #{new Date(achievement.dateAchieved).toLocaleDateString()} at #{achievement.timeOfAchievement}

      .achievement-description
        h2 Description
        p= achievement.description

      .achievement-actions
        button#editAchievementBtn.btn Edit Achievement
        button#deleteAchievementBtn.btn.btn-danger Delete Achievement

      .edit-form.hidden
        h2 Edit Achievement
        form#editAchievementForm
          .form-group
            label(for="title") Title:
            input#title(type="text" name="title" value=achievement.title required)

          .form-group
            label(for="description") Description:
            textarea#description(name="description" required)= achievement.description

          .form-group
            label(for="dateAchieved") Date Achieved:
            input#dateAchieved(type="date" name="dateAchieved" value=achievement.dateAchieved.toISOString().split('T')[0] required)

          .form-group
            label(for="timeOfAchievement") Time of Achievement:
            input#timeOfAchievement(type="time" name="timeOfAchievement" value=achievement.timeOfAchievement required)

          button.btn(type="submit") Update Achievement
          button#cancelEdit.btn(type="button") Cancel
    else
      p Achievement not found

  script.
    // Toggle edit form
    document.getElementById('editAchievementBtn')?.addEventListener('click', () => {
      document.querySelector('.edit-form').classList.toggle('hidden');
    });

    document.getElementById('cancelEdit')?.addEventListener('click', () => {
      document.querySelector('.edit-form').classList.add('hidden');
    });

    // Edit achievement
    document.getElementById('editAchievementForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const achievementData = {
        title: formData.get('title'),
        description: formData.get('description'),
        dateAchieved: formData.get('dateAchieved'),
        timeOfAchievement: formData.get('timeOfAchievement')
      };

      try {
        const response = await fetch(`/achievements/#{achievement._id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(achievementData)
        });

        const result = await response.json();
        if (result.success) {
          window.location.reload();
        } else {
          alert('Failed to update achievement');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred');
      }
    });

    // Delete achievement
    document.getElementById('deleteAchievementBtn')?.addEventListener('click', async () => {
      if (confirm('Are you sure you want to delete this achievement?')) {
        try {
          const response = await fetch(`/achievements/#{achievement._id}`, {
            method: 'DELETE'
          });

          const result = await response.json();
          if (result.success) {
            window.location.href = '/achievements';
          } else {
            alert('Failed to delete achievement');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('An error occurred');
        }
      }
    });
