doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title #{title} - My Profile Website
    link(rel='stylesheet', href='/css/style.css')
  body
    header
      nav.main-nav
        .container
          a.logo(href='/') My Profile
          ul.nav-links
            li
              a(href='/') Home
            li
              a(href='/projects') Projects
            li
              a(href='/achievements') Achievements

    main.container
      block content

    footer
      .container
        p &copy; #{new Date().getFullYear()} My Profile Website. All rights reserved.

    script(src='/js/main.js')
