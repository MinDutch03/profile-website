extends layout

block content
  section.project-detail
    if project
      h1= project.title

      if project.projectUrl
        p.project-link
          a(href=project.projectUrl, target="_blank") Visit Project: #{project.projectUrl}
      p.date #{new Date(project.startDate).toLocaleDateString()} - #{project.endDate ? new Date(project.endDate).toLocaleDateString() : 'Present'}

      .project-description
        h2 Description
        p= project.description

      if project.technologies && project.technologies.length > 0
        .technologies
          h2 Technologies Used
          ul.tech-tags
            each tech in project.technologies
              li= tech

      .project-actions
        button#editProjectBtn.btn Edit Project
        button#deleteProjectBtn.btn.btn-danger Delete Project

      .edit-form.hidden
        h2 Edit Project
        form#editProjectForm
          .form-group
            label(for="title") Title:
            input#title(type="text" name="title" value=project.title required)

          .form-group
            label(for="description") Description:
            textarea#description(name="description" required)= project.description

          .form-group
            label(for="startDate") Start Date:
            input#startDate(type="date" name="startDate" value=project.startDate.toISOString().split('T')[0] required)

          .form-group
            label(for="endDate") End Date (optional):
            input#endDate(type="date" name="endDate" value=project.endDate ? project.endDate.toISOString().split('T')[0] : '')

          .form-group
            label(for="technologies") Technologies (comma separated):
            input#technologies(type="text" name="technologies" value=project.technologies.join(', '))

          .form-group
            label(for="projectUrl") Project URL (optional):
            input#projectUrl(type="text" name="projectUrl" value=project.projectUrl || '')

          button.btn(type="submit") Update Project
          button#cancelEdit.btn(type="button") Cancel
    else
      p Project not found

  script.
    // Toggle edit form
    document.getElementById('editProjectBtn')?.addEventListener('click', () => {
      document.querySelector('.edit-form').classList.toggle('hidden');
    });

    document.getElementById('cancelEdit')?.addEventListener('click', () => {
      document.querySelector('.edit-form').classList.add('hidden');
    });

    // Edit project
    document.getElementById('editProjectForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const projectData = {
        title: formData.get('title'),
        description: formData.get('description'),
        startDate: formData.get('startDate'),
        endDate: formData.get('endDate') || undefined,
        technologies: formData.get('technologies') ? formData.get('technologies').split(',').map(t => t.trim()) : [],
        projectUrl: formData.get('projectUrl') || undefined
      };

      try {
        const response = await fetch(`/projects/#{project._id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(projectData)
        });

        const result = await response.json();
        if (result.success) {
          window.location.reload();
        } else {
          alert('Failed to update project');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred');
      }
    });

    // Delete project
    document.getElementById('deleteProjectBtn')?.addEventListener('click', async () => {
      if (confirm('Are you sure you want to delete this project?')) {
        try {
          const response = await fetch(`/projects/#{project._id}`, {
            method: 'DELETE'
          });

          const result = await response.json();
          if (result.success) {
            window.location.href = '/projects';
          } else {
            alert('Failed to delete project');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('An error occurred');
        }
      }
    });
